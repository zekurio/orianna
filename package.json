    "effect": "^4.1.1",
    "emojibase-data": "18",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "4.1.14",
